{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nulleimy/ENGINEERING-WORKFLOW/schemas/ip-provenance-register.schema.json",
  "title": "ENGINEERING-WORKFLOW IP provenance register",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "licensing_model",
    "intended_exclusive_rights_holder",
    "release_authority",
    "repository_visibility_at_record_creation",
    "open_source_project_license_granted",
    "exclusive_control_status",
    "distribution",
    "contribution_policy",
    "provenance_scopes",
    "release_gates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"const": "ENGINEERING-WORKFLOW"},
    "licensing_model": {"const": "proprietary-all-rights-reserved"},
    "intended_exclusive_rights_holder": {
      "type": "object",
      "required": ["display_name", "legal_identity_status"],
      "properties": {
        "display_name": {"const": "Eimy Herrer"},
        "legal_identity_status": {"enum": ["PENDING_VERIFICATION", "VERIFIED"]}
      },
      "additionalProperties": false
    },
    "release_authority": {"const": "Eimy Herrer"},
    "repository_visibility_at_record_creation": {"enum": ["public", "private", "internal"]},
    "open_source_project_license_granted": {"const": false},
    "exclusive_control_status": {
      "enum": [
        "BLOCKED_PENDING_CONTRIBUTOR_AND_AI_PROVENANCE_AUDIT",
        "VERIFIED_EXCLUSIVE_CONTROL"
      ]
    },
    "distribution": {
      "type": "object",
      "required": [
        "public_source_release",
        "binary_release",
        "package_publication",
        "commercial_licensing",
        "private_internal_use"
      ],
      "additionalProperties": false
    },
    "contribution_policy": {
      "type": "object",
      "required": ["external_contributions", "required_instrument", "dco_alone_is_sufficient"],
      "properties": {
        "external_contributions": {"const": "CLOSED_BY_DEFAULT"},
        "required_instrument": {"const": "PROJECT_SPECIFIC_WRITTEN_EXCLUSIVE_RIGHTS_AGREEMENT"},
        "dco_alone_is_sufficient": {"const": false}
      },
      "additionalProperties": false
    },
    "provenance_scopes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["scope", "category", "status", "required_resolution"],
        "additionalProperties": false
      }
    },
    "release_gates": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
